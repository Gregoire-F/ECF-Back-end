{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .home-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; display: flex; justify-content: center; flex-direction: column; align-items: center; }
    .btn-connexion, .btn-action { display: inline-block; padding: 0.5em 1em; background-color: black; color: white; border: none; border-radius: 4px; text-decoration: none; font-size: 16px; cursor: pointer; }
    .btn-connexion:hover { background-color: #0056b3 }
    .btn-flex { display: flex; margin-top: 20px; }
    .group-btn { display: flex; gap: 10px; margin-top: 20px; }

</style>

<div class="home-wrapper">
    <h1>Bienvenue sur le gestionnaire de livres</h1>
    <!-- Vérifier si l'utilisateur EST connecté -->
    {% if app.user %}
        <!-- Afficher un bouton de déconnexion -->
        <p>Connecté en tant que: {{ app.user.userIdentifier }}</p>
        <a href="{{ path('app_logout') }}" class="btn-connexion">Se déconnecter</a>
        <div class="group-btn">
            <a href="{{ path('app_abonne_index') }}" class="btn-action">Abonnés</a>
            <a href="{{ path('app_emprunt_index')}}" class="btn-action">Emprunts</a>
            <a href="{{ path('app_livre_index')}}" class="btn-action">Livres</a>
        </div>
    {% else %}
        <!-- Sinon afficher le bouton de connexion -->
    <div class="btn-flex"><a href="{{ path('app_login') }}" class="btn-connexion">Vous connecter</a></div>
     {% endif %}

</div>
{% endblock %}
